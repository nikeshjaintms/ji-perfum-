# ==============================================================================
# PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# Rename to .env.production on your live production server (VPS / Cloud / Server)
# ==============================================================================
NODE_ENV=production
PORT=5000

# Live Frontend URL (used for CORS security)
FRONTEND_URL=https://erp.ji-perfume.com

# Production MySQL Connection
# Format: mysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?sslmode=prefer
DATABASE_URL="mysql://jj_erp_user:CHANGE_TO_A_VERY_STRONG_PASSWORD@localhost:3306/jj_perfume_erp_prod"

# Production JWT Secret: Generate a random 64-char hex string (e.g. openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_GENERATE_A_64_CHARACTER_RANDOM_SECRET_KEY_FOR_SECURITY
JWT_EXPIRES_IN=1d

# Official Production Store & UPI VPA details (for Customer Dynamic QR code scan)
STORE_NAME="J I PERFUME"
STORE_UPI_ID="jiperfumes@icici"
STORE_PHONE="+91 98765 43210"
STORE_GSTIN="24AABCJ1234F1Z5"
STORE_ADDRESS="Heritage Bazar, Near Main Gate, Mandvi - 370465, Kutch, Gujarat"
