datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  STORE_MANAGER
  CASHIER
  VIEWER
}

enum Concentration {
  EXTRAIT_DE_PARFUM
  EAU_DE_PARFUM
  EAU_DE_TOILETTE
  EAU_DE_COLOGNE
  ATTAR_OIL
  BODY_MIST
}

enum DiscountType {
  NONE
  FIXED
  PERCENTAGE
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  FAILED
  CANCELLED
}

enum PaymentMethod {
  UPI_QR
  CASH
  CARD
  SPLIT
  CREDIT
}

enum StockMovementType {
  SALE
  PURCHASE_RECEIPT
  ADJUSTMENT
  TRANSFER
  RETURN
}

model City {
  id               String   @id @default(uuid()) @db.VarChar(100)
  name             String   @unique @db.VarChar(100) // e.g. "Mandvi", "Mumbai", "Delhi", "Bengaluru"
  state            String   @db.VarChar(100) // e.g. "Gujarat", "Maharashtra", "Delhi", "Karnataka"
  stateCode        String   @db.VarChar(10)  // e.g. "24", "27", "07", "29"
  jurisdictionText String   @default("Subject to Local Jurisdiction.") @db.VarChar(255)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stores           Store[]

  @@map("cities")
}

model Store {
  id              String         @id @default(uuid()) @db.VarChar(100)
  name            String         @db.VarChar(150) // e.g. "Mandvi Heritage Boutique"
  code            String         @unique @db.VarChar(50) // e.g. "MANDVI-01"
  address         String         @db.Text
  phone           String?        @db.VarChar(50)
  gstin           String?        @db.VarChar(50)
  upiId           String?        @default("jjperfumes@icici") @db.VarChar(100)
  isRetailCounter Boolean        @default(true)
  isActive        Boolean        @default(true)

  cityId          String         @db.VarChar(100)
  city            City           @relation(fields: [cityId], references: [id])

  stockBalances   StockBalance[]
  invoices        Invoice[]
  users           User[]
  stockMovements  StockMovement[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([cityId])
  @@map("stores")
}

model User {
  id               String    @id @default(uuid()) @db.VarChar(100)
  name             String    @db.VarChar(100)
  email            String    @unique @db.VarChar(150)
  passwordHash     String    @db.VarChar(255)
  role             Role      @default(CASHIER)
  isActive         Boolean   @default(true)
  
  assignedStoreId  String?   @db.VarChar(100)
  assignedStore    Store?    @relation(fields: [assignedStoreId], references: [id])

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  invoices         Invoice[] @relation("CashierInvoices")
  stockLogs        StockMovement[]

  @@map("users")
}

model Category {
  id          String    @id @default(uuid()) @db.VarChar(100)
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("categories")
}

model Product {
  id             String         @id @default(uuid()) @db.VarChar(100)
  name           String         @db.VarChar(200)
  sku            String         @unique @db.VarChar(100)
  barcode        String?        @unique @db.VarChar(100)
  brand          String         @default("J I PERFUME") @db.VarChar(100)
  description    String?        @db.Text
  fragranceNotes String?        @db.Text
  concentration  Concentration  @default(EAU_DE_PARFUM)
  volumeMl       Int            @default(100)
  
  purchaseCost   Decimal        @db.Decimal(12, 2)
  sellingPrice   Decimal        @db.Decimal(12, 2)
  taxRate        Decimal        @default(18.00) @db.Decimal(5, 2)

  stockQuantity  Int            @default(0) // Total aggregate stock
  reorderLevel   Int            @default(10)
  isActive       Boolean        @default(true)

  categoryId     String         @db.VarChar(100)
  category       Category       @relation(fields: [categoryId], references: [id])

  stockBalances  StockBalance[]
  invoiceItems   InvoiceItem[]
  stockMovements StockMovement[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([sku])
  @@index([barcode])
  @@index([categoryId])
  @@map("products")
}

model StockBalance {
  id           String   @id @default(uuid()) @db.VarChar(100)
  productId    String   @db.VarChar(100)
  product      Product  @relation(fields: [productId], references: [id])

  storeId      String   @db.VarChar(100)
  store        Store    @relation(fields: [storeId], references: [id])

  quantity     Int      @default(0)
  reorderLevel Int      @default(5)

  updatedAt    DateTime @updatedAt

  @@unique([productId, storeId])
  @@index([productId])
  @@index([storeId])
  @@map("stock_balances")
}

model Customer {
  id        String    @id @default(uuid()) @db.VarChar(100)
  name      String    @db.VarChar(150)
  phone     String?   @unique @db.VarChar(50)
  email     String?   @db.VarChar(150)
  city      String?   @default("Mandvi") @db.VarChar(100)
  address   String?   @db.Text
  gstin     String?   @db.VarChar(50)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  invoices  Invoice[]

  @@map("customers")
}

model Invoice {
  id              String        @id @default(uuid()) @db.VarChar(100)
  invoiceNumber   String        @unique @db.VarChar(100)
  
  customerId      String?       @db.VarChar(100)
  customer        Customer?     @relation(fields: [customerId], references: [id])

  cashierId       String        @db.VarChar(100)
  cashier         User          @relation("CashierInvoices", fields: [cashierId], references: [id])

  storeId         String?       @db.VarChar(100)
  store           Store?        @relation(fields: [storeId], references: [id])

  // Financials
  subtotal        Decimal       @db.Decimal(12, 2)
  discountType    DiscountType  @default(NONE)
  discountValue   Decimal       @default(0.00) @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0.00) @db.Decimal(12, 2)
  taxableAmount   Decimal       @db.Decimal(12, 2)
  taxRate         Decimal       @default(18.00) @db.Decimal(5, 2)
  cgstAmount      Decimal       @default(0.00) @db.Decimal(12, 2)
  sgstAmount      Decimal       @default(0.00) @db.Decimal(12, 2)
  taxAmount       Decimal       @default(0.00) @db.Decimal(12, 2)
  grandTotal      Decimal       @db.Decimal(12, 2)
  paidAmount      Decimal       @default(0.00) @db.Decimal(12, 2)
  dueAmount       Decimal       @default(0.00) @db.Decimal(12, 2)

  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethod @default(UPI_QR)
  
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           InvoiceItem[]
  payments        Payment[]

  @@index([invoiceNumber])
  @@index([createdAt])
  @@index([storeId])
  @@map("invoices")
}

model InvoiceItem {
  id             String   @id @default(uuid()) @db.VarChar(100)
  invoiceId      String   @db.VarChar(100)
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId      String   @db.VarChar(100)
  product        Product  @relation(fields: [productId], references: [id])

  productName    String   @db.VarChar(200)
  sku            String   @db.VarChar(100)
  volumeMl       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  quantity       Int
  totalAmount    Decimal  @db.Decimal(12, 2)

  createdAt      DateTime @default(now())

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

model Payment {
  id                   String        @id @default(uuid()) @db.VarChar(100)
  invoiceId            String        @db.VarChar(100)
  invoice              Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount               Decimal       @db.Decimal(12, 2)
  method               PaymentMethod @default(UPI_QR)
  status               PaymentStatus @default(PENDING)
  
  upiString            String?       @db.Text
  qrDataUrl            String?       @db.LongText
  transactionReference String?       @unique @db.VarChar(150)
  paidAt               DateTime?

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([invoiceId])
  @@map("payments")
}

model StockMovement {
  id             String            @id @default(uuid()) @db.VarChar(100)
  productId      String            @db.VarChar(100)
  product        Product           @relation(fields: [productId], references: [id])

  storeId        String?           @db.VarChar(100)
  store          Store?            @relation(fields: [storeId], references: [id])

  quantityChange Int
  type           StockMovementType
  referenceId    String?           @db.VarChar(100)
  notes          String?           @db.Text
  
  createdById    String?           @db.VarChar(100)
  createdBy      User?             @relation(fields: [createdById], references: [id])

  createdAt      DateTime          @default(now())

  @@index([productId])
  @@index([storeId])
  @@map("stock_movements")
}
